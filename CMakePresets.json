{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "release",
            "displayName": "Release (system dependencies)",
            "description": "Contributor build: optimized, dependencies from the system package manager.",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (system dependencies)",
            "description": "Contributor build: unoptimized, AddressSanitizer except on MinGW.",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo (system dependencies)",
            "description": "Contributor build: optimized with debug info and frame pointers, for profiling.",
            "binaryDir": "${sourceDir}/build-relwithdebinfo",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "macos-vendored",
            "displayName": "macOS universal (vendored dependencies)",
            "description": "Static universal (arm64+x86_64) release binary without an installer. Dependency sources are fetched into the build directory at configure time.",
            "binaryDir": "${sourceDir}/build-macos-vendored",
            "toolchainFile": "${sourceDir}/cmake/macos-toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "OSECT_VENDOR_DEPS": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos-package",
            "inherits": "macos-vendored",
            "displayName": "macOS DMG installer",
            "description": "macos-vendored plus installer configuration and MoltenVK bundling. Building it produces the DMG. Requires the bundled data assets.",
            "binaryDir": "${sourceDir}/build-macos-package",
            "cacheVariables": {
                "OSECT_ENABLE_PACKAGING": "ON"
            }
        },
        {
            "name": "linux-vendored",
            "displayName": "Linux (vendored dependencies)",
            "description": "Static Linux release binary without an installer; depends only on glibc. Dependency sources are fetched into the build directory at configure time. Portable to distros whose glibc is at least the build host's.",
            "binaryDir": "${sourceDir}/build-linux-vendored",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "OSECT_VENDOR_DEPS": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-package",
            "inherits": "linux-vendored",
            "displayName": "Linux AppImage and tarball",
            "description": "linux-vendored plus installer configuration. Building it produces an AppImage and a .tar.xz of the same tree. Requires the bundled data assets and CMake 4.2+.",
            "binaryDir": "${sourceDir}/build-linux-package",
            "cacheVariables": {
                "OSECT_ENABLE_PACKAGING": "ON"
            }
        },
        {
            "name": "mingw-vendored",
            "displayName": "Windows x86_64 cross-compile (vendored dependencies)",
            "description": "Static MinGW-w64 release binary without an installer, cross-compiled from Linux or macOS. Dependency sources are fetched into the build directory at configure time.",
            "binaryDir": "${sourceDir}/build-mingw-vendored",
            "toolchainFile": "${sourceDir}/cmake/mingw-w64-toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "OSECT_VENDOR_DEPS": "ON"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "mingw-package",
            "inherits": "mingw-vendored",
            "displayName": "Windows NSIS installer",
            "description": "mingw-vendored plus installer configuration. Building it produces the NSIS installer. Requires the bundled data assets and NSIS.",
            "binaryDir": "${sourceDir}/build-mingw-package",
            "cacheVariables": {
                "OSECT_ENABLE_PACKAGING": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "release",        "configurePreset": "release" },
        { "name": "debug",          "configurePreset": "debug" },
        { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
        { "name": "macos-vendored", "configurePreset": "macos-vendored" },
        { "name": "macos-package",  "configurePreset": "macos-package", "targets": ["package"] },
        { "name": "linux-vendored", "configurePreset": "linux-vendored" },
        { "name": "linux-package",  "configurePreset": "linux-package", "targets": ["package"] },
        { "name": "mingw-vendored", "configurePreset": "mingw-vendored" },
        { "name": "mingw-package",  "configurePreset": "mingw-package", "targets": ["package"] }
    ],
    "testPresets": [
        {
            "name": "release",
            "configurePreset": "release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "relwithdebinfo",
            "configurePreset": "relwithdebinfo",
            "output": { "outputOnFailure": true }
        }
    ]
}
